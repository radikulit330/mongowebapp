<%- include('../partials/header') %>

<div class="page-header">
    <h1>
        <span class="material-symbols-outlined"><%= locals.isEdit ? 'edit_note' : 'person_add' %></span>
        <%= locals.isEdit ? `Редагувати користувача: ${user.username}` : 'Створити нового користувача' %>
    </h1>
</div>

<% if (locals.error) { %><div class="alert alert-danger"><%= error %></div><% } %>

<div class="form-container">
    <form action="<%= formAction %>" method="POST" class="standard-form">
        <div class="form-group">
            <label for="username">Ім'я користувача:</label>
            <input type="text" id="username" name="username" value="<%= user.username || '' %>" required>
        </div>

        <div class="form-group">
            <label for="email">Email (опціонально):</label>
            <input type="email" id="email" name="email" value="<%= user.email || '' %>">
        </div>

        <div class="form-group">
            <label for="password"><%= locals.isEdit ? 'Новий пароль (залиште порожнім, щоб не змінювати):' : 'Пароль:' %></label>
            <input type="password" id="password" name="password" <%= !locals.isEdit ? 'required' : '' %> minlength="6">
        </div>

        <div class="form-group">
            <label for="storageLimitMB">Ліміт сховища (MB):</label>
            <input type="number" id="storageLimitMB" name="storageLimitMB" value="<%= defaultStorageLimitMB %>" min="0" required>
            <p class="note">Встановіть 0 для необмеженого (не рекомендується для звичайних користувачів).</p>
        </div>

        <div class="form-actions-bottom">
            <button type="submit" class="button save-button">
                <span class="material-symbols-outlined">save</span> <%= locals.isEdit ? 'Оновити користувача' : 'Створити користувача' %>
            </button>
            <a href="/admin/users" class="button cancel-button">
                 <span class="material-symbols-outlined">cancel</span> Скасувати
            </a>
        </div>
    </form>
</div>

<%# Стилі для .standard-form та .form-container вже мають бути у вашому style.css або додайте їх, якщо потрібно %>

<%- include('../partials/footer') %>
