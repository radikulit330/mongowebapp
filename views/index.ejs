<%- include('partials/header') %>

<% const urlParams = new URLSearchParams(locals.queryString || ''); %>
<% const message = urlParams.get('message'); %>
<% const error = urlParams.get('error'); %>
<% if (message) { %><div class="alert alert-success"><%= decodeURIComponent(message) %></div><% } %>
<% if (error) { %><div class="alert alert-danger"><%= decodeURIComponent(error) %></div><% } %>

<%# --- ОНОВЛЕНО БЛОК ПРОГРЕСУ СХОВИЩА --- %>
<% if (storageInfo && !locals.isAdmin) { %>
    <div class="storage-info-card info-card">
        <h3><span class="material-symbols-outlined">data_usage</span> Використання Сховища</h3>
        <p>
            Використано (Дані / Диск): <strong><%= storageInfo.dataFormatted %></strong> / <strong><%= storageInfo.usedFormatted %></strong> з <strong><%= storageInfo.limitFormatted %></strong>
        </p>
        <div class="progress-bar-container">
            <div class="progress-bar" style="width: <%= storageInfo.percentage %>%; background-color: <%= storageInfo.isOverLimit ? 'var(--danger-color)' : 'var(--success-color)' %>;">
                <%= storageInfo.percentage %>%
            </div>
        </div>
        <% if (storageInfo.isOverLimit) { %>
            <p class="alert alert-danger" style="margin-top: 15px; padding: 10px;">
                <span class="material-symbols-outlined" style="vertical-align: middle; font-size: 1.2em;">warning</span>
                <strong>Ліміт сховища перевищено!</strong> Ви не можете створювати нові колекції.
            </p>
        <% } %>
    </div>
<% } %>
<%# ----------------------------- %>


<div class="page-header">
    <h1><span class="material-symbols-outlined">database</span>
        <% if (locals.isAdmin) { %>
            Всі Колекції Бази Даних
        <% } else { %>
            Мої Колекції
        <% } %>
    </h1>
    <a href="/create-collection"
       class="button add-button <%= (storageInfo && storageInfo.isOverLimit) ? 'disabled' : '' %>"
       <% if (storageInfo && storageInfo.isOverLimit) { %>
           title="Ліміт сховища досягнуто"
           onclick="event.preventDefault(); alert('Ліміт сховища досягнуто. Ви не можете створювати нові колекції.');"
       <% } %>>
        <span class="material-symbols-outlined">add_box</span> Створити колекцію
    </a>
</div>

<div class="collection-list">
    <% if (collections && collections.length > 0) { %>
        <% collections.forEach(collection => { %>
            <div class="collection-card">
                <h2>
                    <span class="material-symbols-outlined">folder_open</span>
                    <%= collection.displayNameForCard %>
                </h2>
                <div class="card-actions">
                    <a href="/db/<%= collection.name %>" class="button view-button">
                        <span class="material-symbols-outlined">visibility</span> Переглянути
                    </a>
                    <% if (locals.isAdmin || collection.isOwned) { %>
                        <button type="button" class="button delete-button delete-coll-btn"
                                data-collection="<%= collection.name %>"
                                title="Видалити колекцію">
                            <span class="material-symbols-outlined">delete_forever</span> Видалити
                        </button>
                    <% } %>
                </div>
            </div>
        <% }) %>
    <% } else { %>
        <div class="info-card">
             <p>Колекцій не знайдено.</p>
             <% if (!locals.isAdmin) { %>
                <p>Ви можете <a href="/create-collection">створити свою першу колекцію</a>.</p>
             <% } %>
        </div>
    <% } %>
</div>

<%- include('partials/footer') %>
